import ReflectedSectorChecker

namespace CubeRev029.Nineteen

/-- The exact set of reply values generated by a finite sector at one
address, deduplicated with lawful equality. This is an optimization,
NOT an assumption that a response is impossible because a JSON branch
was omitted. The set is determined by the surviving states themselves. -/
def attainableReplies {S Q R : Type} [BEq R]
    (observe : S → Q → R) (belief : List S) (q : Q) : List R :=
  (belief.map (fun s => observe s q)).eraseDups

/-- Deduplication never drops any reply produced by a still-possible
state. This is the exact premise needed to make one-check-per-answer
equivalent to one-check-per-state. -/
theorem own_reply_is_attainable {S Q R : Type}
    [BEq R] [LawfulBEq R]
    (observe : S → Q → R) (belief : List S) (q : Q)
    (state : S) (member : state ∈ belief) :
    observe state q ∈ attainableReplies observe belief q := by
  simp only [attainableReplies, List.mem_eraseDups, List.mem_map]
  exact ⟨state, member, rfl⟩

/-- Operationally viable reflected checker for the frozen 52-root data.
At a read it checks only the distinct physically possible colors, at
most six for the Rubik edge color sensor. This avoids revisiting the
same giant posterior once for each candidate that produces the color.
At every node the loop is a total finite computation, and recursion
still decreases the actual remaining observation budget. -/
def checkDistinctSector {S Q R : Type}
    [DecidableEq S] [DecidableEq R] [BEq R]
    (graph : Array (FrozenInstruction Q R Unit))
    (observe : S → Q → R) (sign : S → Bool) :
    (budget : Nat) → (root : Nat) → (belief : List S) → Bool
  | 0, idx, belief =>
      match graph[idx]? with
      | some (.finish _) => checkSignUnique sign belief
      | _ => false
  | n+1, idx, belief =>
      match graph[idx]? with
      | none => false
      | some (.finish _) => checkSignUnique sign belief
      | some (.choose q child) =>
          allFinite (fun reply =>
            checkDistinctSector graph observe sign n (child reply)
              (finiteReplyFiber observe belief q reply))
            (attainableReplies observe belief q)
      | some (.padding _ child) =>
          checkDistinctSector graph observe sign n child belief

/-- General soundness of the *efficient* finite certificate validator.
No node counts, receipt checks, JSON schema assumptions or domain-
specific Rubik axioms enter this proof. In particular, the list of
distinct replies may be short but it includes every feasible reply. -/
theorem checkDistinctSector_sound {S Q R : Type}
    [DecidableEq S] [DecidableEq R] [BEq R] [LawfulBEq R]
    (graph : Array (FrozenInstruction Q R Unit))
    (observe : S → Q → R) (sign : S → Bool) :
    ∀ budget root belief,
      checkDistinctSector graph observe sign budget root belief = true →
      StatewiseSectorValid graph observe sign budget root belief := by
  intro budget
  induction budget with
  | zero =>
      intro root belief accepted
      cases found : graph[root]? with
      | none =>
          simp [checkDistinctSector, found] at accepted
      | some instruction =>
          cases instruction with
          | finish value =>
              have ok : checkSignUnique sign belief = true := by
                simpa [checkDistinctSector, found] using accepted
              have leaf : AtMostOnePerSign sign belief :=
                checkSignUnique_sound sign belief ok
              simpa only [StatewiseSectorValid, found] using leaf
          | choose q child =>
              simp [checkDistinctSector, found] at accepted
          | padding q child =>
              simp [checkDistinctSector, found] at accepted
  | succ n ih =>
      intro root belief accepted
      cases found : graph[root]? with
      | none =>
          simp [checkDistinctSector, found] at accepted
      | some instruction =>
          cases instruction with
          | finish value =>
              have ok : checkSignUnique sign belief = true := by
                simpa [checkDistinctSector, found] using accepted
              have leaf : AtMostOnePerSign sign belief :=
                checkSignUnique_sound sign belief ok
              simpa only [StatewiseSectorValid, found] using leaf
          | padding q child =>
              have nextValid : checkDistinctSector graph observe sign
                  n child belief = true := by
                simpa [checkDistinctSector, found] using accepted
              simpa only [StatewiseSectorValid, found] using
                ih child belief nextValid
          | choose q child =>
              have validReplies : ∀ state, state ∈ belief →
                  StatewiseSectorValid graph observe sign n
                    (child (observe state q))
                    (finiteReplyFiber observe belief q
                      (observe state q)) := by
                intro state present
                have allChecked :
                    allFinite (fun reply =>
                      checkDistinctSector graph observe sign n
                        (child reply)
                        (finiteReplyFiber observe belief q reply))
                      (attainableReplies observe belief q) = true := by
                  simpa [checkDistinctSector, found] using accepted
                have checked :=
                  allFinite_true_implies_every_member
                    (fun reply =>
                      checkDistinctSector graph observe sign n
                        (child reply)
                        (finiteReplyFiber observe belief q reply))
                    (attainableReplies observe belief q)
                    allChecked (observe state q)
                    (own_reply_is_attainable observe belief q
                      state present)
                exact ih (child (observe state q))
                  (finiteReplyFiber observe belief q (observe state q))
                  checked
              simpa only [StatewiseSectorValid, found] using validReplies

/-- Exact eight real continuation frames and terminal recovery from an
accepted fast sector certificate. The sign is still supplied only to
the returned decoder after all those physical reads are completed. -/
theorem checked_distinct_eight_sector_recovers
    {S Q R : Type}
    [DecidableEq S] [DecidableEq R] [BEq R] [LawfulBEq R]
    (fallback : Q)
    (graph : Array (FrozenInstruction Q R Unit))
    (observe : S → Q → R) (sign : S → Bool)
    (root : Nat) (belief : List S)
    (accepted : checkDistinctSector graph observe sign 8 root belief = true)
    (state : S) (member : state ∈ belief) :
    ((exactEightSectorPolicy fallback graph observe sign root belief).run
        observe state) (sign state) = some state := by
  exact exact_eight_sector_recovers_given_terminal_sign
    fallback graph observe sign root belief
    (checkDistinctSector_sound graph observe sign 8 root belief accepted)
    state member

/-- The checker rejects a same-sign pair if both reach one leaf, while
an actual first color read can separate the pair and make two later
singleton leaves valid. This is a semantic—not just a syntax—control. -/
private def splitTwo : Array (FrozenInstruction Nat Nat Unit) :=
  #[.choose 0 (fun color => if color == 0 then 1 else 2),
    .finish (), .finish ()]

private def allEven (_ : Nat) : Bool := false

private def singleLeaf : Array (FrozenInstruction Nat Nat Unit) :=
  #[.finish ()]

theorem distinct_reply_split_accepts_two_same_sign_states :
    checkDistinctSector splitTwo (fun s (_ : Nat) => s)
      allEven 1 0 [0,1] = true := by
  decide +kernel

theorem unresolved_same_sign_leaf_is_rejected :
    checkDistinctSector singleLeaf (fun s (_ : Nat) => s)
      allEven 0 0 [0,1] = false := by
  decide +kernel

#print axioms own_reply_is_attainable
#print axioms checkDistinctSector_sound
#print axioms checked_distinct_eight_sector_recovers
#print axioms distinct_reply_split_accepts_two_same_sign_states
#print axioms unresolved_same_sign_leaf_is_rejected

end CubeRev029.Nineteen
