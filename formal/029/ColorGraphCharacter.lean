import NineteenSymmetry

namespace CubeRev029.Nineteen

open Eighteen

set_option maxRecDepth 16000
set_option maxHeartbeats 0

/-- The three opposite-pair blocks are {U,D}, {R,L}, {F,B}.
The underlying color codes are inherited from Eighteen.colors = "BDFLRU". -/
def oppositePairCode (c : Nat) : Nat :=
  if c == 5 || c == 1 then 0
  else if c == 4 || c == 3 then 1
  else 2

/-- A center-color automorphism induces a permutation of the three
opposite-color blocks, not necessarily a physical fixed-center rotation. -/
def inducedThreePairPermutation (sigma : List Nat) : List Nat :=
  [oppositePairCode sigma[5]!,
   oppositePairCode sigma[4]!,
   oppositePairCode sigma[2]!]

/-- The same color automorphism permutes the twelve unordered edge types. -/
def inducedTwelveEdgePermutation (sigma : List Nat) : List Nat :=
  (List.range 12).map (relabeledEdgeType sigma)

theorem every_symmetry_permutes_opposite_pairs :
    ∀ sigma ∈ symmetries,
      (inducedThreePairPermutation sigma).Perm (List.range 3) := by
  decide +kernel

/-- Specific sign character: the parity of the permutation of twelve edge
types equals that of the three opposite-color blocks. The paper gives an
independent generator proof: internal pair flips induce four transpositions
(even); swapping entire pairs induces five transpositions (odd). -/
theorem induced_edge_sign_is_three_pair_sign :
    ∀ sigma ∈ symmetries,
      parity (inducedTwelveEdgePermutation sigma) =
        parity (inducedThreePairPermutation sigma) := by
  decide +kernel

/-- Five elementary generators of (C₂)^3 ⋊ S₃: three opposite-pair internal
flips, and two adjacent swaps of entire opposite-color pairs. -/
def fiveColorGenerators : List (List Nat) :=
  [[0,5,2,3,4,1],
   [0,1,2,4,3,5],
   [2,1,0,3,4,5],
   [0,3,2,1,5,4],
   [3,1,4,0,2,5]]

def composeCenterMaps (sigma tau : List Nat) : List Nat :=
  (List.range 6).map (fun i => sigma[tau[i]!]!)

/-- An undirected word-ball in the finite Cayley graph, retaining all
previously reached maps. Each elementary map is an involution. -/
def cayleyBall : Nat → List (List Nat)
  | 0 => [List.range 6]
  | n+1 =>
      let previous := cayleyBall n
      (previous ++ previous.flatMap (fun sigma =>
        fiveColorGenerators.map (composeCenterMaps sigma))).eraseDups

theorem color_generators_are_valid_symmetries :
    ∀ generator ∈ fiveColorGenerators, generator ∈ symmetries := by
  decide +kernel

/-- Every one of the forty-eight color graph automorphisms is generated by
five actual swaps in at most six steps. This is a small *Cayley graph
reachability* certificate, not enumeration of the 12! edge permutations. -/
theorem cayley_six_steps_cover_all_color_symmetries :
    (cayleyBall 6).length = 48 ∧
      ∀ sigma ∈ symmetries, sigma ∈ cayleyBall 6 := by
  decide +kernel

#print axioms every_symmetry_permutes_opposite_pairs
#print axioms induced_edge_sign_is_three_pair_sign
#print axioms color_generators_are_valid_symmetries
#print axioms cayley_six_steps_cover_all_color_symmetries

end CubeRev029.Nineteen
