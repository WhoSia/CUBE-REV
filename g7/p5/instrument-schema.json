{
  "schema_version":"g7-p5-instrument-events-1",
  "required_event_types":["session_start","trial_presented","choice_committed","trial_complete","session_complete"],
  "session_fields":["session_id","packet_sha256","instrument_version","consent_status","started_monotonic_ms"],
  "trial_fields":["trial_id","pair_id","state_id","condition_id","representation_family","display_horizon_condition","slack_band","choice_order_seed"],
  "choice_fields":["choice_token","latency_ms","confidence_ordinal"],
  "privacy":{
    "direct_identifier_fields_forbidden":["name","email","phone","school_id","ip_address"],
    "participant_key":"opaque_session_local_or_study_pseudonym_only"
  },
  "timing":{
    "clock":"performance.now monotonic browser clock",
    "latency_origin":"trial_visible event completion",
    "latency_end":"choice input handler"
  }
}
